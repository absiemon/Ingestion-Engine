model Vehicle {
  id        String   @id @default(cuid())
  vehicleId String   @unique

  regNumber String?
  brand     String?
  model     String?
  year      Int?

  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId])
}

model Meter {
  id        String   @id @default(cuid())
  meterId   String   @unique

  location  String?
  status    String   @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([meterId])
}

model VehicleLiveStatus {
  vehicleId String  @id

  soc            Float
  batteryTemp    Float
  lastKwhDc      Float
  updatedAt      DateTime @updatedAt

  @@index([updatedAt])
}

model MeterLiveStatus {
  meterId String @id

  voltage        Float
  lastKwhAc      Float
  updatedAt      DateTime @updatedAt

  @@index([updatedAt])
}

model VehicleTelemetryHistory {
  id        BigInt   @id @default(autoincrement())

  vehicleId String
  soc       Float
  batteryTemp Float
  kwhDeliveredDc Float
  timestamp DateTime

  createdAt DateTime @default(now())

  @@index([vehicleId, timestamp])
  @@unique([vehicleId, timestamp])
}

model MeterTelemetryHistory {
  id        BigInt   @id @default(autoincrement())

  meterId   String
  voltage   Float
  kwhConsumedAc Float
  timestamp DateTime

  createdAt DateTime @default(now())

  @@index([meterId, timestamp])
  @@unique([meterId, timestamp])
}

model VehicleEnergyHourly {
  id        BigInt   @id @default(autoincrement())

  vehicleId String
  hour      DateTime

  totalDc   Float
  totalAc   Float
  avgBatteryTemp Float

  createdAt DateTime @default(now())

  @@unique([vehicleId, hour])
  @@index([vehicleId, hour])
}
