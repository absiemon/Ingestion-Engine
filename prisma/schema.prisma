// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Meter data model for energy ingestion
model Meter {
  id        String   @id @default(cuid())
  meterId   String   @unique
  deviceId  String
  timestamp DateTime @default(now())
  
  // Energy consumption data
  voltage   Float    // in Volts
  current   Float    // in Amperes
  power     Float    // in Watts
  energy    Float    // in kWh
  
  // Metadata
  location  String?
  status    String   @default("active")
  
  // Relations
  telemetry Telemetry[]
  analytics Analytics[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([deviceId])
  @@index([timestamp])
}

// Vehicle data model
model Vehicle {
  id        String   @id @default(cuid())
  vehicleId String   @unique
  regNumber String   @unique
  
  // Vehicle details
  brand     String
  model     String
  year      Int
  type      String   // EV, Hybrid, etc.
  
  // Telemetry data
  status    String   @default("active")
  lastSeen  DateTime @default(now())
  
  // Relations
  telemetry Telemetry[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([regNumber])
  @@index([lastSeen])
}

// Telemetry data model for real-time tracking
model Telemetry {
  id        String   @id @default(cuid())
  
  // Relations
  meter     Meter?   @relation(fields: [meterId], references: [id], onDelete: Cascade)
  meterId   String?
  
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId String?
  
  // Telemetry data
  type      String   // "meter" | "vehicle"
  data      Json     // flexible data storage
  
  timestamp DateTime @default(now())
  processed Boolean  @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([meterId])
  @@index([vehicleId])
  @@index([timestamp])
  @@index([processed])
}

// Analytics aggregation model
model Analytics {
  id        String   @id @default(cuid())
  
  // Relations
  meter     Meter    @relation(fields: [meterId], references: [id], onDelete: Cascade)
  meterId   String
  
  // Aggregated metrics
  period    String   // "hourly" | "daily" | "monthly"
  
  avgPower  Float    // Average power consumption
  maxPower  Float    // Peak power
  minPower  Float    // Minimum power
  totalEnergy Float  // Total energy for period
  
  dataPoints Int     // Number of data points in aggregation
  
  // Time window
  startTime DateTime
  endTime   DateTime
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([meterId, period, startTime])
  @@index([meterId])
  @@index([startTime])
}

// Queue processing model
model QueueJob {
  id        String   @id @default(cuid())
  
  // Job details
  type      String   // "ingest" | "process" | "analyze"
  status    String   @default("pending") // "pending" | "processing" | "completed" | "failed"
  
  // Payload
  payload   Json
  result    Json?
  
  // Retry logic
  attempts  Int      @default(0)
  maxAttempts Int    @default(3)
  error     String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([status])
  @@index([type])
  @@index([createdAt])
}
